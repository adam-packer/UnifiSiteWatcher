        "MAIL_FROM": "unifi-alerts@yourcompany.com",
        "MAIL_TO": "noc@yourcompany.com;you@yourcompany.com",
        "GRAPH_TENANT_ID": "<tenant guid - local dev only, Azure uses managed identity>",
        "GRAPH_CLIENT_ID": "<app registration client id - local dev only>",
        "GRAPH_CLIENT_SECRET": "<app registration client secret - local dev only>"
    }
